APP_ENV=development
MONGODB_URL=mongodb://localhost:27017
DB_NAME=speakeasy_asd
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_COOKIE_NAME=speakeasy_access
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_BYTES=10485760
EXPOSE_DEV_CODES=true
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
ELEVENLABS_API_KEY=
ELEVENLABS_STORY_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
TAMIL_SPEECH_VOICE=ta-IN-PallaviNeural
INDICCONFORMER_ENABLED=true
INDICCONFORMER_MODEL_PATH=../indicconformer_stt_ta_hybrid_rnnt_large.nemo
INDICCONFORMER_DEVICE=auto
# Development-only deterministic care-loop seed. Never reuse a production secret.
DEMO_CARE_LOOP_PASSWORD=replace-for-local-demo-only
PHONEME_MODEL_ID=facebook/wav2vec2-lv-60-espeak-cv-ft
PHONEME_CPU_THREADS=2
# Optional override; defaults to backend/models/phoneme-onnx
# PHONEME_ONNX_PATH=C:/final_year_project/backend/models/phoneme-onnx
# Optional clinician PDF delivery. A caregiver must also configure a doctor
# recipient and consent in the app before the daily scheduler sends anything.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Official Meta WhatsApp Business Cloud API and approved document-header template.
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=
